<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\StockSharp (GitHub)\props\common_target_net.props" />
  <PropertyGroup>
    <!-- Everything in this repository is open source and ships to nuget.org. A connector kept
         off the public feed does not belong here: it belongs in the apps repository. -->
    <IsPrivatePackable>false</IsPrivatePackable>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>S#.$(MSBuildProjectName)</InformationalVersion>
    <SourceRevisionId>v$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoGitHubPath)Messages\Messages.csproj" />
    <ProjectReference Include="$(RepoGitHubPath)Media.Names\Media.Names.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>